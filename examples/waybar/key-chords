#!/usr/bin/env zsh

setopt extended_glob
zmodload zsh/net/socket
zsocket $NIRI_SOCKET || exit 1
print -u $REPLY '"KeyChordStream"'
while read -r line; do
    if [[ $line == *'"keys":"'* ]]; then
        keys=${${line#*\"keys\":\"}%\"\}\}}
        print -r -- ${keys//(#b)\\(?)/$match[1]}
    else
        print
    fi
done <&$REPLY
