(in-package #:nucleotide/tests)

(def-suite which-key :in :nucleotide)
(in-suite which-key)

(defun connect-wm-with-xkb-seat (display socket)
  "The wm, the requests that set up its seat and the id of its xkb seat."
  (let ((wm (connect-wm display socket)))
    (deliver display socket 2 "wl_registry" "global" 2 "river_xkb_bindings_v1" 3)
    (deliver display socket +window-manager+ "river_window_manager_v1" "seat" +seat+)
    (values wm (received socket display) (n::proxy-id (n::wm-xkb-seat wm)))))

(defun modifiers-watches (requests xkb-seat)
  (loop for (nil request object body) in requests
        when (and (eql object xkb-seat) (equal request "modifiers_watch"))
        collect (n::u32ref body 0)))

(defun timers (wm)
  (n::loop-timers (n::wm-loop wm)))

(defun run-timers (wm)
  "Run the timers of WM as if they were due."
  (dolist (timer (timers wm))
    (setf (n::loop-timer-deadline timer) 0))
  (n::run-due-timers (n::wm-loop wm)))

(defun shown (wm)
  (n::which-key-shown (n::wm-which-key wm)))

(defmacro with-which-key-wm ((wm created update press) &body body)
  "Run BODY with WM on a fake river. UPDATE delivers old and new modifiers and
returns those watched next, PRESS delivers an event."
  (let ((display (gensym "DISPLAY"))
        (socket (gensym "SOCKET"))
        (xkb-seat (gensym "XKB-SEAT")))
    `(with-fake-server (,display ,socket)
       (multiple-value-bind (,wm ,created ,xkb-seat) (connect-wm-with-xkb-seat ,display ,socket)
         (declare (ignorable ,created))
         (setf (n::wm-loop ,wm) (n::%make-event-loop))
         (flet ((,update (old new)
                  (deliver ,display ,socket ,xkb-seat "river_xkb_bindings_seat_v1"
                           "modifiers_update" old new)
                  (run-sequence ,display ,socket "manage_start")
                  (modifiers-watches (received ,socket ,display) ,xkb-seat))
                (,press (object interface event)
                  (deliver ,display ,socket object interface event)))
           (declare (ignorable #',update #',press))
           (run-sequence ,display ,socket "manage_start")
           (received ,socket ,display)
           ,@body)))))

(test (holding-the-leader-shows-its-bindings-after-the-delay :fixture fresh-config)
  (let ((super n::+river-seat-v1-modifiers-mod4+)
        (shift n::+river-seat-v1-modifiers-shift+))
    (setf n::*which-key-delay* 500)
    (n::bind "Super+Q" n::close-window)
    (with-which-key-wm (wm created update press)
      (is (equal (list n::+all-modifiers+) (update 0 super)))
      (is (= 1 (length (timers wm))))
      (is (null (shown wm)))
      (run-timers wm)
      (is (= super (shown wm)))
      (update super (logior super shift))
      (is (= (logior super shift) (shown wm)))
      (press (key-binding created #x71) "river_xkb_binding_v1" "pressed")
      (is (null (shown wm)))
      (is (equal (list super) (update super 0))))))

(test (the-leader-alone-is-watched-until-it-is-held :fixture fresh-config)
  (setf n::*which-key-delay* 500)
  (with-fake-server (display socket)
    (multiple-value-bind (wm created xkb-seat) (connect-wm-with-xkb-seat display socket)
      (declare (ignore wm created))
      (run-sequence display socket "manage_start")
      (is (equal (list n::+river-seat-v1-modifiers-mod4+)
                 (modifiers-watches (received socket display) xkb-seat))))))

(test (a-binding-pressed-before-the-delay-cancels-it :fixture fresh-config)
  (setf n::*which-key-delay* 500)
  (n::bind "Super+Q" n::close-window)
  (with-which-key-wm (wm created update press)
    (update 0 n::+river-seat-v1-modifiers-mod4+)
    (press (key-binding created #x71) "river_xkb_binding_v1" "pressed")
    (is (null (timers wm)))
    (is (null (shown wm)))))

(test (releasing-the-leader-cancels-the-delay :fixture fresh-config)
  (let ((super n::+river-seat-v1-modifiers-mod4+))
    (setf n::*which-key-delay* 500)
    (with-which-key-wm (wm created update press)
      (update 0 super)
      (update super 0)
      (is (null (timers wm)))
      (update 0 super)
      (is (= 1 (length (timers wm))))
      (run-timers wm)
      (is (= super (shown wm)))
      (update super 0)
      (is (null (shown wm))))))

(test (locking-the-session-hides-which-key :fixture fresh-config)
  (let ((super n::+river-seat-v1-modifiers-mod4+)
        (shift n::+river-seat-v1-modifiers-shift+))
    (setf n::*which-key-delay* 500)
    (with-which-key-wm (wm created update press)
      (update 0 super)
      (run-timers wm)
      (press +window-manager+ "river_window_manager_v1" "session_locked")
      (is (null (shown wm)))
      (update super (logior super shift))
      (is (null (shown wm)))
      (is (null (timers wm))))))

(test (all-modifiers-of-the-leader-must-be-held :fixture fresh-config)
  (let ((alt n::+river-seat-v1-modifiers-mod1+))
    (setf n::*which-key-delay* 500
          n::*which-key-modifier* "Super+Alt")
    (with-which-key-wm (wm created update press)
      (update 0 alt)
      (is (null (timers wm)))
      (update alt (logior alt n::+river-seat-v1-modifiers-mod4+))
      (is (= 1 (length (timers wm)))))
    (setf n::*which-key-modifier* "")
    (signals n::nucleotide-error (n::check-settings))))

(test (without-a-delay-nothing-is-watched-or-shown :fixture fresh-config)
  (setf n::*which-key-delay* 500)
  (with-which-key-wm (wm created update press)
    (setf n::*which-key-delay* nil)
    (n::uninstall-all-keybinds wm)
    (n::install-all-keybinds wm)
    (is (equal '(0) (update 0 n::+river-seat-v1-modifiers-mod4+)))
    (is (null (timers wm)))))

(test (reinstalling-the-bindings-hides-which-key :fixture fresh-config)
  (setf n::*which-key-delay* 500)
  (with-which-key-wm (wm created update press)
    (update 0 n::+river-seat-v1-modifiers-mod4+)
    (run-timers wm)
    (n::uninstall-all-keybinds wm)
    (n::install-all-keybinds wm)
    (is (null (shown wm)))))

(test (key-entries-describe-the-keys-that-follow :fixture fresh-config)
  (n::bind "Super+Q" n::close-window :description "close")
  (n::bind "Super+Shift+Q" n::exit-session)
  (n::bind "Super+Space T" (n::set-layout n::tiling))
  (n::bind "Super+Space M" (n::set-layout n::monocle) :description "monocle")
  (n::bind "Super+H" (n::focus :left))
  (let ((entries (n::modifier-entries n::*bindings*))
        (super n::+river-seat-v1-modifiers-mod4+))
    (is (equal '(("Q" . "close") ("Space") ("H" . "focus :left"))
               (entry-pairs (n::alist-get super entries))))
    (is (equal '(("Q" . "exit-session"))
               (entry-pairs
                (n::alist-get (logior super n::+river-seat-v1-modifiers-shift+) entries))))
    (is (equal '(("T" . "set-layout tiling") ("M" . "monocle"))
               (entry-pairs (n::alist-get (n::parse-key "Super+Space")
                                          (n::chord-entries n::*bindings*)))))))

(test (which-key-subscribers-see-the-modifiers-which-key-shows :fixture fresh-config)
  (n::bind "Super+Shift+Q" n::exit-session :description "quit")
  (n::bind "Super+Shift+Space T" (n::set-layout n::tiling))
  (let ((wm (make-test-wm)))
    (setf (n::wm-modifier-entries wm) (n::modifier-entries n::*bindings*)
          (n::which-key-shown (n::wm-which-key wm))
          (logior n::+river-seat-v1-modifiers-mod4+ n::+river-seat-v1-modifiers-shift+))
    (is (equal (list (concatenate 'string
                                  "{\"WhichKeyChanged\":{\"keys\":\"Super+Shift\",\"bindings\":"
                                  "[{\"key\":\"Q\",\"description\":\"quit\"},"
                                  "{\"key\":\"Space\",\"prefix\":true}]}}"))
               (n::which-key-events wm)))
    (setf (n::wm-active-submap wm) (n::make-submap :keys "Super+Space"))
    (is (search "\"keys\":\"Super+Space\"" (first (n::which-key-events wm))))))
