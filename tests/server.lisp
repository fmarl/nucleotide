(test (locking-disables-the-bindings-until-unlocked :fixture fresh-config)
  (n::bind "Super+Q" n::close-window)
  (n::bind "Super+Space M" (n::set-layout n::monocle))
  (with-fake-server (display socket)
    (let ((wm (connect-wm display socket)))
      (deliver display socket 2 "wl_registry" "global" 2 "river_xkb_bindings_v1" 2)
      (deliver display socket +window-manager+ "river_window_manager_v1" "seat" +seat+)
      (let* ((created (received socket display))
             (quit (key-binding created #x71))
             (chord (key-binding created #x6d)))
        (run-sequence display socket "session_locked")
        (run-sequence display socket "manage_start")
        (let ((requests (received socket display)))
          (is (equal '("disable") (requests-to quit requests)))
          (is (equal '("disable") (requests-to chord requests))))
        (n::uninstall-all-keybinds wm)
        (n::install-all-keybinds wm)
        (received socket display)
        (run-sequence display socket "manage_start")
        (is (not (member "enable" (received socket display) :key #'second :test #'equal)))
        (run-sequence display socket "session_unlocked")
        (run-sequence display socket "manage_start")
        (let ((enabled (sort (mapcar #'third (remove "enable" (received socket display)
                                                     :key #'second :test-not #'equal))
                             #'<)))
          (is (= 4 (length enabled)))
          (is (equal (sort (mapcar #'n::proxy-id (n::wm-bindings wm)) #'<)
                     enabled)))
        (run-sequence display socket "session_locked")
        (run-sequence display socket "manage_start")
        (received socket display)
        (run-sequence display socket "session_unlocked")
        (n::uninstall-all-keybinds wm)
        (n::install-all-keybinds wm)
        (received socket display)
        (run-sequence display socket "manage_start")
        (let ((enabled (mapcar #'third (remove "enable" (received socket display)
                                               :key #'second :test-not #'equal))))
          (is (= 4 (length enabled)))
          (is (= 4 (length (remove-duplicates enabled)))))))))

