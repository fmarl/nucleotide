      (is (n::window-floating-p win))
      (is (not (n::window-maximized-p win))))))

(test (keyboards-and-pointers-get-the-repeat-and-scroll-settings :fixture fresh-config)
  (setf n::*key-repeat* '(40 300)
        n::*scroll-factor* 1/2)
  (with-fake-server (display socket)
    (connect-wm display socket)
    (deliver display socket 2 "wl_registry" "global" 2 "river_input_manager_v1" 1)
    (received socket display)
    (let ((manager 4)
          (keyboard #xff000010)
          (pointer #xff000011))
      (deliver display socket manager "river_input_manager_v1" "input_device" keyboard)
      (deliver display socket keyboard "river_input_device_v1" "type" 0)
      (deliver display socket manager "river_input_manager_v1" "input_device" pointer)
      (deliver display socket pointer "river_input_device_v1" "type" 1)
      (let* ((requests (received socket display))
             (repeat (fourth (first requests)))
             (scroll (fourth (second requests))))
        (is (equal '(("river_input_device_v1" "set_repeat_info")
                     ("river_input_device_v1" "set_scroll_factor"))
                   (names requests)))
        (is (equal '(40 300) (list (n::u32ref repeat 0) (n::u32ref repeat 4))))
        (is (= 128 (n::u32ref scroll 0)))))))
