(in-package #:nucleotide/tests)

(def-suite server :in :nucleotide)
(in-suite server)

;;; A fake river on a real socket.

(defparameter *core-messages*
  '(("wl_display" ("sync" "get_registry") ("error" "delete_id"))
    ("wl_registry" ("bind") ("global" "global_remove"))
    ("wl_callback" () ("done"))))

(defun message-names (interface kind)
  (let ((core (assoc interface *core-messages* :test #'equal)))
    (if core
        (if (eq kind :request) (second core) (third core))
        (loop for file in (directory (merge-pathnames "*.xml" (asdf:system-relative-pathname
                                                               "nucleotide" "protocol/")))
              for node = (find interface
                               (xml:children-named (xml:parse (uiop:read-file-string file))
                                                   "interface")
                               :key (lambda (node) (xml:attribute node "name"))
                               :test #'equal)
              when node
              return (mapcar (lambda (message) (xml:attribute message "name"))
                             (xml:children-named node (if (eq kind :request)
                                                          "request"
                                                          "event")))))))

(defun call-with-fake-server (function)
  (with-private-directory (directory)
    (let ((path (format nil "~A/wayland-test" directory))
          (listener (make-instance 'sb-bsd-sockets:local-socket :type :stream)))
      (sb-bsd-sockets:socket-bind listener path)
      (sb-bsd-sockets:socket-listen listener 1)
      (let* ((display (n::wl-display-connect path))
             (socket (sb-bsd-sockets:socket-accept listener)))
        (setf (sb-bsd-sockets:non-blocking-mode socket) t)
        (unwind-protect (funcall function display socket)
          (n::wl-display-disconnect display)
          (sb-bsd-sockets:socket-close socket)
          (sb-bsd-sockets:socket-close listener))))))

(defmacro with-fake-server ((display socket) &body body)
  `(call-with-fake-server (lambda (,display ,socket) ,@body)))

(defun deliver (display socket object interface event &rest args)
  "Send EVENT with ARGS, integers or strings, and let nucleotide handle it."
  (let* ((buffer (buffer 512))
         (end (reduce (lambda (offset arg)
                        (if (stringp arg)
                            (n::put-wl-string buffer offset arg)
                            (progn (setf (n::u32ref buffer offset) (ldb (byte 32 0) arg))
                                   (+ offset 4))))
                      args :initial-value 8)))
    (setf (n::u32ref buffer 0) object
          (n::u32ref buffer 4) (logior (ash end 16)
                                       (position event (message-names interface :event)
                                                 :test #'equal)))
    (sb-bsd-sockets:socket-send socket (subseq buffer 0 end) end)
    (n::dispatch-event display)))

(defun received (socket display)
  "The requests sent since the last call, as (interface request object body)."
  (let ((input (make-array 0 :element-type '(unsigned-byte 8)))
        (chunk (buffer 4096)))
    (loop for length = (nth-value 1 (sb-bsd-sockets:socket-receive socket chunk nil))
          while length
          do (setf input (concatenate 'n::octets input (subseq chunk 0 length))))
    (loop with offset = 0
          while (< offset (length input))
          collect (let* ((object (n::u32ref input offset))
                         (word (n::u32ref input (+ offset 4)))
                         (size (ash word -16))
                         (proxy (gethash object (n::display-proxies display)))
                         (interface (n::interface-wire-name (class-name (class-of proxy)))))
                    (prog1 (list interface
                                 (nth (logand word #xffff) (message-names interface :request))
                                 object
                                 (subseq input (+ offset 8) (+ offset size)))
                      (incf offset size))))))

(defun names (requests)
  (mapcar (lambda (request) (subseq request 0 2)) requests))

(defconstant +window-manager+ 3)
(defconstant +window+ #xff000000)
(defconstant +output+ #xff000001)
(defconstant +seat+ #xff000002)

(defun connect-wm (display socket)
  (let ((wm (n::make-wm display)))
    (deliver display socket 2 "wl_registry" "global" 1 "river_window_manager_v1" 9)
    (received socket display)
    wm))

(defun connect-wm-with-window (display socket)
  "A WM with an output of 1000x800, a seat without key bindings and one window,
and the requests it sent so far."
  (let ((wm (connect-wm display socket)))
    (deliver display socket +window-manager+ "river_window_manager_v1" "output" +output+)
    (deliver display socket +output+ "river_output_v1" "dimensions" 1000 800)
    (let ((*error-output* (make-broadcast-stream)))
      (deliver display socket +window-manager+ "river_window_manager_v1" "seat" +seat+))
    (deliver display socket +window-manager+ "river_window_manager_v1" "window" +window+)
    (values wm (received socket display))))

(defun run-sequence (display socket event)
  (deliver display socket +window-manager+ "river_window_manager_v1" event))

(defun requests-to (object requests)
  (mapcar #'second (remove object requests :key #'third :test-not #'eql)))

(defun created-id (requests request key key-offset id-offset)
  (let ((body (fourth (find-if (lambda (candidate)
                                 (and (equal request (second candidate))
                                      (= key (n::u32ref (fourth candidate) key-offset))))
                               requests))))
    (n::u32ref body id-offset)))

(defun key-binding (requests keysym)
  (created-id requests "get_xkb_binding" keysym 8 4))

(defun pointer-binding (requests button)
  (created-id requests "get_pointer_binding" button 4 0))

(test (globals-are-bound-at-the-highest-common-version :fixture fresh-config)
  (with-fake-server (display socket)
    (let ((wm (n::make-wm display)))
      (is (equal '(("wl_display" "get_registry")) (names (received socket display))))
      (deliver display socket 2 "wl_registry" "global" 1 "river_window_manager_v1" 9)
      (deliver display socket 2 "wl_registry" "global" 2 "unknown_global_v1" 1)
      (let ((requests (received socket display)))
        (is (equal '(("wl_registry" "bind")) (names requests)))
        (let ((body (fourth (first requests))))
          (is (equal "river_window_manager_v1" (n::get-wl-string body 4)))
          (is (= 4 (n::u32ref body (- (length body) 8))))))
      (is (= +window-manager+ (n::proxy-id (n::wm-river wm)))))))

(test (a-new-window-is-configured-placed-and-focused-in-one-manage-sequence
       :fixture fresh-config)
  (with-fake-server (display socket)
    (let ((wm (connect-wm-with-window display socket)))
      (deliver display socket +window-manager+ "river_window_manager_v1" "manage_start")
      (let* ((requests (received socket display))
             (to-window (remove +window+ requests :key #'third :test-not #'eql))
             (proposed (fourth (car (last to-window)))))
        (is (equal '("set_tiled" "use_ssd" "set_capabilities" "propose_dimensions")
                   (mapcar #'second to-window)))
        (is (equal '(984 784) (list (n::u32ref proposed 0) (n::u32ref proposed 4))))
        (is (member '("river_seat_v1" "focus_window") (names requests) :test #'equal))
        (is (equal '("river_window_manager_v1" "manage_finish") (car (last (names requests))))))
      (let ((win (n::wm-focus wm)))
        (is (equal '(8 8) (list (n::window-x win) (n::window-y win))))))))

(test (closing-a-window-destroys-its-proxies :fixture fresh-config)
  (with-fake-server (display socket)
    (let ((wm (connect-wm display socket)))
      (deliver display socket +window-manager+ "river_window_manager_v1" "window" +window+)
      (received socket display)
      (deliver display socket +window+ "river_window_v1" "closed")
      (is (equal '(("river_node_v1" "destroy") ("river_window_v1" "destroy"))
                 (names (received socket display))))
      (is (null (n::all-windows wm))))))

(test (an-empty-workspace-clears-the-focus :fixture fresh-config)
  (with-fake-server (display socket)
    (let ((wm (connect-wm-with-window display socket)))
      (deliver display socket +window-manager+ "river_window_manager_v1" "manage_start")
      (is (member '("river_seat_v1" "focus_window") (names (received socket display))
                  :test #'equal))
      (n::switch-workspace wm 2)
      (received socket display)
      (deliver display socket +window-manager+ "river_window_manager_v1" "manage_start")
      (is (member '("river_seat_v1" "clear_focus") (names (received socket display))
                  :test #'equal)))))

(test (chord-keys-are-enabled-only-after-their-prefix :fixture fresh-config)
  (n::bind "Super+Q" n::close-window)
  (n::bind "Super+Space M" (n::set-layout n::monocle))
  (with-fake-server (display socket)
    (let ((wm (connect-wm display socket)))
      (deliver display socket 2 "wl_registry" "global" 2 "river_xkb_bindings_v1" 2)
      (deliver display socket +window-manager+ "river_window_manager_v1" "seat" +seat+)
      (let* ((created (received socket display))
             (quit (key-binding created #x71))
             (prefix (key-binding created #x20))
             (chord (key-binding created #x6d))
             (xkb-seat (n::proxy-id (n::wm-xkb-seat wm))))
        (run-sequence display socket "manage_start")
        (let ((requests (received socket display)))
          (is (equal '("enable") (requests-to quit requests)))
          (is (equal '("enable") (requests-to prefix requests)))
          (is (null (requests-to chord requests))))
        (deliver display socket prefix "river_xkb_binding_v1" "pressed")
        (run-sequence display socket "manage_start")
        (let ((requests (received socket display)))
          (is (equal '("enable") (requests-to chord requests)))
          (is (equal '("ensure_next_key_eaten") (requests-to xkb-seat requests))))
        (deliver display socket chord "river_xkb_binding_v1" "pressed")
        (run-sequence display socket "manage_start")
        (is (equal '("disable") (requests-to chord (received socket display))))
        (is (typep (n::wm-active-layout wm) 'n::monocle))))))

(test (render-shows-the-visible-windows-and-hides-the-others :fixture fresh-config)
  (with-fake-server (display socket)
    (let* ((wm (connect-wm-with-window display socket))
           (node (n::proxy-id (n::window-node (n::wm-focus wm)))))
      (run-sequence display socket "manage_start")
      (received socket display)
      (run-sequence display socket "render_start")
      (let ((requests (received socket display)))
        (is (equal '("show" "set_borders" "set_clip_box") (requests-to +window+ requests)))
        (is (equal '("set_position" "place_top") (requests-to node requests)))
        (is (equal "render_finish" (second (car (last requests))))))
      (n::switch-workspace wm 2)
      (run-sequence display socket "manage_start")
      (received socket display)
      (run-sequence display socket "render_start")
      (is (equal '("hide") (requests-to +window+ (received socket display)))))))

(test (dragging-a-window-floats-and-moves-it :fixture fresh-config)
  (with-fake-server (display socket)
    (multiple-value-bind (wm created) (connect-wm-with-window display socket)
      (let ((move (pointer-binding created n::*move-button*))
            (win (n::wm-focus wm)))
        (run-sequence display socket "manage_start")
        (deliver display socket +window+ "river_window_v1" "dimensions" 984 784)
        (deliver display socket +seat+ "river_seat_v1" "pointer_enter" +window+)
        (deliver display socket move "river_pointer_binding_v1" "pressed")
        (received socket display)
        (run-sequence display socket "manage_start")
        (let ((requests (received socket display)))
          (is (equal '("op_start_pointer" "focus_window") (requests-to +seat+ requests)))
          (is (member "set_tiled" (requests-to +window+ requests) :test #'equal)))
        (deliver display socket +seat+ "river_seat_v1" "op_delta" 100 -50)
        (deliver display socket +seat+ "river_seat_v1" "op_release")
        (run-sequence display socket "manage_start")
        (is (member "op_end" (requests-to +seat+ (received socket display)) :test #'equal))
        (is (n::window-floating-p win))
        (is (equal '(108 -42) (n::window-float-offset win)))))))
