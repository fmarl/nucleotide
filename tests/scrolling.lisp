(in-package #:nucleotide/tests)

(def-suite scrolling :in :nucleotide)
(in-suite scrolling)

(defun make-scrolling-workspace ()
  (let ((ws (make-instance 'n::workspace :name "test")))
    (setf (n::workspace-layout ws) (make-instance 'n::scrolling))
    ws))

(defun open-window (ws)
  (let ((win (make-instance 'n::window)))
    (n::add-window ws win)
    (arrange ws)
    win))

(defun arrange (ws &optional (tiled (n::workspace-windows ws)))
  (let ((layout (n::workspace-layout ws)))
    (n::layout-update layout ws tiled (n::rect 0 0 1016 816))
    (boxes (n::layout-arrange layout ws tiled (n::rect 0 0 1016 816)))))

(defun focus (ws win)
  (setf (n::workspace-focus ws) win)
  (arrange ws))

(defun columns (ws)
  (mapcar #'n::column-windows (n::scrolling-columns (n::workspace-layout ws))))

(defun rect (ws win)
  (nth (position win (n::workspace-windows ws)) (arrange ws)))

(test (new-windows-open-right-of-the-focused-column :fixture fresh-config)
  (let* ((ws (make-scrolling-workspace))
         (a (open-window ws))
         (b (open-window ws)))
    (is (equal (list (list a) (list b)) (columns ws)))
    (focus ws a)
    (let ((c (open-window ws)))
      (is (equal (list (list a) (list c) (list b)) (columns ws))))))

(test (half-width-columns-fill-the-view :fixture fresh-config)
  (let* ((ws (make-scrolling-workspace))
         (a (open-window ws))
         (b (open-window ws)))
    (is (equal '(8 8 496 800) (rect ws a)))
    (is (equal '(512 8 496 800) (rect ws b)))))

(test (view-scrolls-just-enough :fixture fresh-config)
  (let* ((ws (make-scrolling-workspace))
         (a (open-window ws))
         (b (open-window ws))
         (c (open-window ws)))
    (is (equal '(-496 8 496 800) (rect ws a)))
    (is (equal '(512 8 496 800) (rect ws c)))
    (focus ws b)
    (is (equal '(8 8 496 800) (rect ws b)))
    (focus ws a)
    (is (equal '(8 8 496 800) (rect ws a)))))

(test (focus-and-move-between-columns :fixture fresh-config)
  (let* ((ws (make-scrolling-workspace))
         (layout (n::workspace-layout ws))
         (a (open-window ws))
         (b (open-window ws)))
    (is (eq a (n::layout-neighbor layout ws b :prev)))
    (is (null (n::layout-neighbor layout ws b :next)))
    (n::layout-move layout ws b :prev)
    (is (equal (list (list b) (list a)) (columns ws)))))

(test (consume-and-expel :fixture fresh-config)
  (let* ((ws (make-scrolling-workspace))
         (layout (n::workspace-layout ws))
         (a (open-window ws))
         (b (open-window ws)))
    (setf (n::scrolling-columns layout)
          (n::consume-or-expel-in (n::scrolling-columns layout) b :prev))
    (is (equal (list (list a b)) (columns ws)))
    (is (eq a (n::layout-neighbor layout ws b :up)))
    (is (equal '((8 8 496 396) (8 412 496 396))
               (list (rect ws a) (rect ws b))))
    (setf (n::scrolling-columns layout)
          (n::consume-or-expel-in (n::scrolling-columns layout) b :next))
    (is (equal (list (list a) (list b)) (columns ws)))))

(test (successor-prefers-the-same-column :fixture fresh-config)
  (let* ((ws (make-scrolling-workspace))
         (layout (n::workspace-layout ws))
         (a (open-window ws))
         (b (open-window ws))
         (c (open-window ws)))
    (declare (ignore a))
    (setf (n::scrolling-columns layout)
          (n::consume-or-expel-in (n::scrolling-columns layout) c :prev))
    (is (eq b (n::layout-successor layout ws c)))
    (is (eq c (n::layout-successor layout ws b)))))

(test (successor-falls-back-to-the-left-column :fixture fresh-config)
  (let* ((ws (make-scrolling-workspace))
         (layout (n::workspace-layout ws))
         (a (open-window ws))
         (b (open-window ws)))
    (is (eq a (n::layout-successor layout ws b)))))

(test (column-widths :fixture fresh-config)
  (let ((n::*column-widths* '(1/3 1/2 2/3)))
    (is (= 2/3 (n::next-preset n::*column-widths* 1/2)))
    (is (= 1/3 (n::next-preset n::*column-widths* 2/3)))
    (is (= 1/3 (n::next-preset n::*column-widths* 1)))))

(test (full-width-column :fixture fresh-config)
  (let* ((ws (make-scrolling-workspace))
         (layout (n::workspace-layout ws))
         (a (open-window ws)))
    (setf (n::scrolling-columns layout)
          (list (n::make-column (list a) 1)))
    (is (equal '(8 8 1000 800) (rect ws a)))))

(test (fullscreen-windows-keep-their-column :fixture fresh-config)
  (let* ((ws (make-scrolling-workspace))
         (a (open-window ws))
         (b (open-window ws)))
    (is (equal '((512 8 496 800)) (arrange ws (list b))))
    (is (equal (list (list a) (list b)) (columns ws)))))

(test (closed-windows-leave-their-column :fixture fresh-config)
  (let* ((ws (make-scrolling-workspace))
         (a (open-window ws))
         (b (open-window ws)))
    (n::remove-window b)
    (is (eq a (n::workspace-focus ws)))
    (arrange ws)
    (is (equal (list (list a)) (columns ws)))))

(test (floating-windows-lead-back-to-the-last-column :fixture fresh-config)
  (let* ((ws (make-scrolling-workspace))
         (a (open-window ws))
         (b (open-window ws))
         (dialog (make-instance 'n::window)))
    (declare (ignore b))
    (focus ws a)
    (setf (n::%window-floating-p dialog) t)
    (n::add-window ws dialog)
    (focus ws dialog)
    (dolist (direction '(:prev :next :up :down))
      (is (eq a (n::layout-neighbor (n::workspace-layout ws) ws dialog direction))))))

(test (size-changes-take-fractions-and-niri-percentages :fixture fresh-config)
  (is (= 1/2 (funcall (n::size-changer "50%") 1/3)))
  (is (= 3/5 (funcall (n::size-changer "+10%") 1/2)))
  (is (= 2/5 (funcall (n::size-changer "-10%") 1/2)))
  (is (= 2/3 (funcall (n::size-changer 2/3) 1/2)))
  (dolist (change '("10" "+%" "x%" "+10%%" "--10%" "+-10%" "+ 10%" "%" "" :wide))
    (signals n::nucleotide-error (n::size-changer change))))

(defun scrolling-wm ()
  (let* ((wm (make-test-wm))
         (ws (n::output-workspace (add-output wm 0))))
    (setf (n::workspace-layout ws) (make-instance 'n::scrolling))
    (values wm ws)))

(defmacro with-scrolling-wm ((wm ws) &body body)
  `(multiple-value-bind (,wm ,ws) (scrolling-wm)
     (with-stubs ((n::mark-dirty (lambda (wm) (declare (ignore wm)))))
       ,@body)))

(test (column-widths-change-within-bounds :fixture fresh-config)
  (with-scrolling-wm (wm ws)
    (let ((a (open-window ws)))
      (n::set-column-width wm "+10%")
      (is (equal '(8 8 597 800) (rect ws a)))
      (n::set-column-width wm "100%")
      (n::set-column-width wm "+10%")
      (is (equal '(8 8 1000 800) (rect ws a)))
      (n::set-column-width wm 0)
      (is (= 1/10 (n::column-width (first (n::scrolling-columns
                                           (n::workspace-layout ws)))))))))

(defun stack (ws &rest windows)
  (let ((layout (n::workspace-layout ws)))
    (setf (n::scrolling-columns layout)
          (list (n::make-column windows 1/2)))
    (arrange ws)))

(test (window-heights-are-set-and-the-others-share-the-rest :fixture fresh-config)
  (with-scrolling-wm (wm ws)
    (let* ((a (open-window ws))
           (b (open-window ws))
           (c (open-window ws)))
      (stack ws a b c)
      (focus ws a)
      (n::set-window-height wm "50%")
      (is (equal '((8 8 496 392) (8 408 496 196) (8 612 496 196))
                 (list (rect ws a) (rect ws b) (rect ws c))))
      (n::set-window-height wm "+10%")
      (is (equal '(8 8 496 470) (rect ws a)))
      (n::reset-window-height wm)
      (is (equal '((8 8 496 261) (8 277 496 261) (8 546 496 262))
                 (list (rect ws a) (rect ws b) (rect ws c)))))))

(test (window-heights-cycle-through-presets :fixture fresh-config)
  (with-scrolling-wm (wm ws)
    (let ((n::*window-heights* '(1/3 1/2 2/3))
          (a (open-window ws))
          (b (open-window ws)))
      (stack ws a b)
      (focus ws a)
      (n::cycle-window-height wm)
      (is (equal '((8 8 496 528) (8 544 496 264)) (list (rect ws a) (rect ws b))))
      (n::cycle-window-height wm)
      (is (equal '(8 8 496 264) (rect ws a))))))

(test (set-heights-fill-a-column-without-other-windows :fixture fresh-config)
  (let* ((a (make-instance 'n::window))
         (b (make-instance 'n::window))
         (column (n::make-column (list a b) 1/2 nil (list (cons a 1/4) (cons b 1/4)))))
    (is (equal '(1/2 1/2) (n::height-fractions column (list a b))))
    (is (equal '(1) (n::height-fractions column (list a))))))

(test (windows-that-leave-a-column-take-no-height-along :fixture fresh-config)
  (let* ((a (make-instance 'n::window))
         (b (make-instance 'n::window))
         (c (make-instance 'n::window))
         (column (n::make-column (list a b c) 1/2 nil (list (cons a 1/4)))))
    (is (null (n::column-heights (n::copy-column column :windows (list b c)))))))

(test (windows-alone-in-their-column-keep-no-height :fixture fresh-config)
  (with-scrolling-wm (wm ws)
    (let ((a (open-window ws))
          (b (open-window ws)))
      (focus ws a)
      (n::cycle-window-height wm)
      (focus ws b)
      (n::consume-or-expel wm :left)
      (is (equal (list (list a b)) (columns ws)))
      (is (null (n::column-heights (first (n::scrolling-columns (n::workspace-layout ws)))))))))

(test (heights-change-from-what-the-column-shows :fixture fresh-config)
  (with-scrolling-wm (wm ws)
    (let* ((a (open-window ws))
           (b (open-window ws))
           (f (open-window ws)))
      (stack ws a b f)
      (setf (n::%window-fullscreen f) :output)
      (focus ws a)
      (n::cycle-window-height wm)
      (is (= 2/3 (n::alist-get a (n::column-heights
                                  (first (n::scrolling-columns (n::workspace-layout ws))))))))))
