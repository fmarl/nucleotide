(in-package #:nucleotide)

(defun use-defaults ()
  "Without an init file nucleotide calls it itself."
  (bind "Super+Shift+Return" (spawn "alacritty"))
  (bind "Super+P" (spawn "bemenu-run"))
  (bind "Super+H" (focus :left))
  (bind "Super+L" (focus :right))
  (bind "Super+K" (focus :up))
  (bind "Super+J" (focus :down))
  (bind "Super+Shift+H" (move :left))
  (bind "Super+Shift+L" (move :right))
  (bind "Super+Shift+K" (move :up))
  (bind "Super+Shift+J" (move :down))
  (bind "Super+BracketLeft" (consume-or-expel :left))
  (bind "Super+BracketRight" (consume-or-expel :right))
  (bind "Super+R" cycle-column-width)
  (bind "Super+Minus" (set-column-width "-10%"))
  (bind "Super+Equal" (set-column-width "+10%"))
  (bind "Super+Shift+R" cycle-window-height)
  (bind "Super+Shift+Minus" (set-window-height "-10%"))
  (bind "Super+Shift+Equal" (set-window-height "+10%"))
  (bind "Super+Ctrl+R" reset-window-height)
  (bind "Super+F" toggle-full-width)
  (bind "Super+C" center-column)
  (bind "Super+Shift+Space" toggle-floating)
  (bind "Super+Tab" switch-window)
  (bind "Super+Comma" (focus-output :left))
  (bind "Super+Period" (focus-output :right))
  (bind "Super+Shift+Comma" (send-to-output :left))
  (bind "Super+Shift+Period" (send-to-output :right))
  (bind "Super+Ctrl+Comma" (move-workspace-to-output :left))
  (bind "Super+Ctrl+Period" (move-workspace-to-output :right))
  (bind "Super+Shift+F" toggle-fullscreen)
  (bind "Super+Q" close-window)
  ;; Keyboards like emacs58 send the digits shifted.
  (loop for n from 1 to 9
        do (set-binding (format nil "Super+~D" n) `(switch-workspace ,n))
        (set-binding (format nil "Super+Shift+~D" n) `(switch-workspace ,n))
        (set-binding (format nil "Super+Ctrl+~D" n) `(send-to-workspace ,n))
        (set-binding (format nil "Super+Ctrl+Shift+~D" n) `(send-to-workspace ,n)))
  (bind "Super+Space T" (set-layout tiling))
  (bind "Super+Space M" (set-layout monocle))
  (bind "Super+Space S" (set-layout scrolling))
  (bind "Super+Space E" (toggle-highlight :app-id "emacs"))
  (bind "Super+Space R" toggle-repl)
  (bind "Super+Space C" reload-config)
  (bind "Super+Space Q" exit-session))
